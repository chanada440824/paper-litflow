# 将本文件复制为 .env 并填入你的 API key
# DeepSeek key 获取: https://platform.deepseek.com/api_keys
# 注意: .env 已被 .gitignore 忽略, 永远不要提交 key 到仓库
DEEPSEEK_API_KEY=sk-your-key-here

# ---- 可选: 换模型 / 本地 Ollama / OCR (不填则用默认) ----
# PAPER_LITFLOW_API_KEY=sk-xxx
# PAPER_LITFLOW_BASE_URL=https://api.deepseek.com/v1            # 或 http://localhost:11434/v1 (Ollama)
# PAPER_LITFLOW_MODEL=deepseek-chat
# PAPER_LITFLOW_TESSERACT=C:\Program Files\Tesseract-OCR\tesseract.exe
# PAPER_LITFLOW_TESSDATA=C:\Users\you\.paper-litflow\tessdata
